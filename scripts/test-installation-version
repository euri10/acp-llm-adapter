#!/usr/bin/env python3
"""Exercise the release version guard on disposable files."""

from pathlib import Path
import shutil
import subprocess
import tempfile
import unittest

CHECKER = Path(__file__).resolve().parent / "check-installation-version"


class InstallationVersionTest(unittest.TestCase):
    def setUp(self):
        self.temporary = tempfile.TemporaryDirectory()
        self.addCleanup(self.temporary.cleanup)
        self.root = Path(self.temporary.name)
        (self.root / "scripts").mkdir()
        (self.root / "docs").mkdir()
        shutil.copy(CHECKER, self.root / "scripts/check-installation-version")
        self.manifest = self.root / "Cargo.toml"
        self.document = self.root / "docs/installation.md"
        self.manifest.write_text('[package]\nversion = "1.2.3"\n')
        self.document.write_text('Example:\n\nversion=1.2.3\n')

    def run_check(self, *args):
        return subprocess.run(
            ["python3", str(self.root / "scripts/check-installation-version"), *args],
            capture_output=True,
            text=True,
            check=False,
        )

    def test_bump_fails_until_release_update(self):
        self.assertEqual(self.run_check().returncode, 0)
        self.manifest.write_text('[package]\nversion = "1.2.4"\n')
        failure = self.run_check()
        self.assertNotEqual(failure.returncode, 0)
        self.assertIn("1.2.3 does not match Cargo.toml 1.2.4", failure.stderr)
        self.assertEqual(self.run_check("--write").returncode, 0)
        self.assertEqual(self.document.read_text(), 'Example:\n\nversion=1.2.4\n')
        self.assertEqual(self.run_check().returncode, 0)

    def test_update_rejects_ambiguous_recipe(self):
        original = 'version=1.2.3\nversion=1.2.3\n'
        self.document.write_text(original)
        self.assertNotEqual(self.run_check("--write").returncode, 0)
        self.assertEqual(self.document.read_text(), original)


if __name__ == "__main__":
    unittest.main(verbosity=2)
